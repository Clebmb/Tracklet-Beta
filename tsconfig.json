{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "phaser-ui-canvas": [
        "vendor/phaser-ui-canvas/src/index.ts"
      ],
      "phaser-ui-canvas/*": [
        "vendor/phaser-ui-canvas/src/*"
      ]
    }
  },
  "include": [
    "src",
    "API",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
